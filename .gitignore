.claude/agents/
.claude/agents-content/

# 通用命令（非内容创作专用）
.claude/commands/

# 通用 hooks 模板
.claude/hooks/

# 通用知识库
.claude/knowledge/

# 通用模板
.claude/templates/

# 用户配置文件
.claude/settings.json
.claude/settings.local.json

# 评估/分析/报告文件
.claude/*-assessment.md
.claude/*-analysis.md
.claude/*-report.md
.claude/*-completion.md

